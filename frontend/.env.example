# SlackOrd frontend — copy to `frontend/.env` or use `.env.production` for hosted builds.
# Local dev: leave unset to use Vite proxy.
# Production (set to your API host).
# Current deploy:
# VITE_API_URL=https://riff-chat-api.onrender.com
# After Render service rename:
# VITE_API_URL=https://slackord-api.onrender.com
